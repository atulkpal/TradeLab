rules_version = '2';

// Academy video delivery — Epic 27
// Public read (videos are static teaching assets), zero public writes.
// Uploads happen via firebase-admin (service account) which BYPASSES these rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /videos/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else locked by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
